;; Derived from records/packets/sleepresp.yaml by bin/spec_records.py -- edit the record, not this file.
(def boxes-per-row 9)
(def box-width 100)
(def left-margin 20)
(defattrs :plain {:font-family "Arial" :font-size 18})
(defattrs :cursive {:font-family "Arial" :font-size 18 :font-style "italic"})
(defattrs :bg-lightblue {:fill "#cfe2f3"})

(defn row-header-fn
  [{:keys [address gap?]}]
  (let [addr-label (str " ")]
    (text addr-label)))

(draw-box (text "Byte \\ Bit") :bg-lightblue)
(doseq [val (str/split "7,6,5,4,3,2,1,0" #",")]
  (draw-box (text val) :bg-lightblue))

(draw-box "1" {:fill "#eeeeee"})
(draw-box "Length" {:span 8 :text-anchor "start"})
(draw-box "2" {:fill "#eeeeee"})
(draw-box "Packet Type" {:span 8 :text-anchor "start"})
(draw-box "SLEEPRESP Flags" [:bold {:fill "#dddddd" :span 9 :text-anchor "start"}])
(draw-box "" {})
(draw-box "Reserved" {:fill "#eeeeee" :span 7})
(draw-box "Sleep Dur" {:fill "#eeeeee" :span 1})
(draw-box "3" {})
(draw-box "0" {:span 1})
(draw-box "0" {:span 1})
(draw-box "0" {:span 1})
(draw-box "0" {:span 1})
(draw-box "0" {:span 1})
(draw-box "0" {:span 1})
(draw-box "0" {:span 1})
(draw-box "X" {:span 1})
(draw-box "3" {:fill "#eeeeee"})
(draw-box "Packet Identifier MSB" {:span 8 :text-anchor "start"})
(draw-box "4" {:fill "#eeeeee"})
(draw-box "Packet Identifier LSB" {:span 8 :text-anchor "start"})
(draw-box (text "Sleep Duration" :plain [:cursive " (S=4 or 0) - only present when Sleep Dur flag is set"]) [:bold {:fill "#dddddd" :span 9 :text-anchor "start"}])
(draw-box "5" {:fill "#eeeeee"})
