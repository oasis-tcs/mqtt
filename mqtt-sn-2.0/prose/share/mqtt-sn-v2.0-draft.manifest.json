{"generated":"2026-10-30T22:19:57.000942+00:00","metadata":{"creator":"OASIS Message Queuing Telemetry Transport (MQTT) TC","date":"2026-10-29","description":"This specification defines the MQTT for Sensor Networks protocol (MQTT-SN). It is closely related to the MQTT v3.1.1 and MQTT v5.0 standards. MQTT-SN is optimized for implementation on low-cost, battery-operated devices with limited processing and storage resources. It is designed so that it will work over a variety of networking technologies and bridge to an MQTT network.","identifier":"https://docs.oasis-open.org/mqtt/mqtt-sn/v2.0/csd01/mqtt-sn-v2.0-csd01.md","language":"en","publisher":"OASIS Open","rights":"Copyright © OASIS Open 2026. All Rights Reserved. Provided under the Non-Assertion Mode of the OASIS IPR Policy (https://www.oasis-open.org/policies-guidelines/ipr/).","status":"DRAFT","subject":"MQTT, MQTT-SN, sensor networks, publish/subscribe, IoT, constrained devices","title":"MQTT for Sensor Networks Version 2.0","type":"Specification","version":"Committee Specification Draft 01"},"outputs":{"gfm-plus":{"bytes":531585,"hashes":[{"alg":"sha256","norm":"lf","value":"9ba1ba0f10ee8a5ac26fa7c59d2524fd52959e80f4b7373ebd1971d5f6046014"},{"alg":"blake3","norm":"lf","value":"91fbc8979fef6be134b2f2a24b031d175e2e990531410570e5edcd1ab04b92dd"}],"path":"build/gfm-plus.md"},"html":{"bytes":531554,"hashes":[{"alg":"sha256","norm":"lf","value":"e3c5ea6d43d74b8e9ab5ea5ad9efe22fff0ca1e87153a26c3546eae046133816"},{"alg":"blake3","norm":"lf","value":"9f5d4f6987607ca8e28b9aae8f39efd35fa45d41f0ed7e3538a8f0877cb632a5"}],"path":"build/html.md"},"mqtt-sn-typst.pdf":{"bytes":3637651,"hashes":[{"alg":"sha256","norm":"binary","value":"cdf55d9490b2ce287fea79add2ccd22eddfc951381a075c1fbb81a1d5dbc6830"},{"alg":"blake3","norm":"binary","value":"d49ba9888b162c6e71dde0da86b59e5deee92e1b213694af6bebe395ff3168ba"}],"path":"build/mqtt-sn-typst.pdf"},"typst":{"bytes":507732,"hashes":[{"alg":"sha256","norm":"lf","value":"0dd915f1ed721b3