<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="pyHanko 0.35.2">
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
<rdf:Description xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:xmp="http://ns.adobe.com/xap/1.0/" xmlns:ns0="http://ns.adobe.com/xap/1.0/t/pg/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:ns1="http://ns.adobe.com/xap/1.0/mm/" xmlns:pdf="http://ns.adobe.com/pdf/1.3/" xmlns:ns2="http://purl.org/dc/terms/" xmp:CreatorTool="Typst 0.15.1" xmp:ModifyDate="2026-10-30T23:19:58+01:00" xmp:CreateDate="2026-10-29T00:00:00+00:00" ns0:NPages="125" dc:format="application/pdf" ns1:InstanceID="opgZGBzDYRaDuS/FFTorIA==" ns1:DocumentID="opgZGBzDYRaDuS/FFTorIA==" ns1:RenditionClass="proof" pdf:PDFVersion="1.7" rdf:about="" dc:identifier="https://docs.oasis-open.org/mqtt/mqtt-sn/v2.0/csd01/mqtt-sn-v2.0-csd01.md" ns2:hasVersion="Committee Specification Draft 01" ns2:abstract="DRAFT" pdf:Producer="pyHanko 0.35.2"><dc:language xmlns:dc="http://purl.org/dc/elements/1.1/"><rdf:Bag><rdf:li>en</rdf:li></rdf:Bag></dc:language><dc:publisher><rdf:Alt><rdf:li>OASIS Open</rdf:li></rdf:Alt></dc:publisher><dc:rights><rdf:Alt><rdf:li>Copyright Â© OASIS Open 2026. All Rights Reserved. Provided under the Non-Assertion Mode of the OASIS IPR Policy (https://www.oasis-open.org/policies-guidelines/ipr/).</rdf:li></rdf:Alt></dc:rights><dc:subject><rdf:Bag><rdf:li>MQTT</rdf:li><rdf:li>MQTT-SN</rdf:li><rdf:li>sensor networks</rdf:li><rdf:li>publish/subscribe</rdf:li><rdf:li>IoT</rdf:li><rdf:li>constrained devices</rdf:li></rdf:Bag></dc:subject><dc:type><rdf:Bag><rdf:li>Specification</rdf:li></rdf:Bag></dc:type><dc:title><rdf:Alt><rdf:li xml:lang="x-default">MQTT for Sensor Networks Version 2.0</rdf:li></rdf:Alt></dc:title><dc:creator><rdf:Seq><rdf:li>OASIS Message Queuing Telemetry Transport (MQTT) TC</rdf:li></rdf:Seq></dc:creator><dc:description><rdf:Alt><rdf:li xml:lang="x-default">This specification defines the MQTT for Sensor Networks protocol (MQTT-SN). It is closely related to the MQTT v3.1.1 and MQTT v5.0 standards. MQTT-SN is optimized for implementation on low-cost, battery-operated devices with limited processing and storage resources. It is designed so that it will work over a variety of networking technologies and bridge to an MQTT network.</rdf:li></rdf:Alt></dc:description></rdf:Description>
</rdf:RDF>
</x:xmpmeta>
<?xpacket end="r"?>
endstream
